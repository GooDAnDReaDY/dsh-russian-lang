{
  "name": "@goodandready/dsh-russian-lang",
  "version": "0.4.17",
  "description": "Полная русская локализация DeepSeek Harness (DSH): ядро v0.2.1-rc.4 + 85 плагинов экосистемы, 11,880 UI keys, 100% покрытие экосистемы, естественный русский язык",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./pure": {
      "types": "./lib/pure.d.ts",
      "import": "./lib/pure.js"
    },
    "./locales": "./lib/locales.js",
    "./commands": {
      "types": "./lib/commands.d.ts",
      "import": "./lib/commands.js"
    },
    "./safe-locale-proxy": {
      "types": "./lib/safe-locale-proxy.d.ts",
      "import": "./lib/safe-locale-proxy.js"
    },
    "./ui": {
      "types": "./lib/ui/index.d.ts",
      "import": "./lib/ui/index.js"
    }
  },
  "files": [
    "lib",
    "!lib/client.template.js",
    "!lib/locales/plugins-en",
    "bin",
    "glossary.json",
    "cordis.patch.yml",
    "README.md",
    "README.ru.md",
    "README.zh.md",
    "DESIGN.md",
    "NOTICE",
    "LICENSE",
    "supported-inventory.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible",
        "0.2.1-rc.4": "compatible"
      },
      "dsh": "0.2.0-rc.2 || >=0.2.1-rc.2 <0.2.2-0"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "i18n",
    "locale",
    "russian"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "dsh": "0.2.0-rc.2 || >=0.2.1-rc.2 <0.2.2-0"
  },
  "scripts": {
    "test": "node --check lib/index.js && node --check lib/client.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4 || ~4.0.5",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2 || >=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2 || >=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2 || >=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/dsh-commands": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2 || >=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2 || >=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2 || >=0.2.1-rc.2 <0.2.2-0",
    "@deepseek-ai/schemastery": "~3.18.4 || ~3.18.5",
    "react": "^18.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GooDAnDReaDY/dsh-russian-lang.git"
  },
  "homepage": "https://github.com/GooDAnDReaDY/dsh-russian-lang#readme",
  "bugs": {
    "url": "https://github.com/GooDAnDReaDY/dsh-russian-lang/issues"
  },
  "bin": {
    "dsh-i18n": "./bin/dsh-i18n.mjs"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    }
  },
  "types": "./lib/index.d.ts",
  "sideEffects": false,
  "dependencies": {}
}
