{
  "name": "@goodandready/dsh-russian-lang",
  "version": "0.3.42",
  "description": "Production-ready Russian translation plugin for DeepSeek Harness (DSH v0.2.1-alpha.2, 9,554 UI keys, 100% coverage, 87 plugins supported). Zero runtime dependencies, instant DOM hot-patching, full offline support.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/client.template.js",
    "bin",
    "glossary.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "i18n",
    "locale",
    "russian"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": "^0.2.0-rc.2"
  },
  "scripts": {
    "build": "python3 build.py",
    "check": "python3 build.py --check && python3 tools/lint_translations.py && python3 check-coverage.py && python3 tools/term_check.py --ci && python3 tools/check_pack_size.py && python3 tools/check_data_integrity.py",
    "test": "node --test test/*.mjs && node test/_repro.cjs && python3 test/test_tools.py && python3 test/test_extract.py && python3 test/test_overflow.py",
    "smoke": "python3 test/smoke.py",
    "lint": "python3 tools/lint_translations.py"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "^0.1.7-rc.2 || ^0.2.0-rc.1 || ^0.2.0-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GooDAnDReaDY/dsh-russian-lang.git"
  },
  "homepage": "https://github.com/GooDAnDReaDY/dsh-russian-lang#readme",
  "bugs": {
    "url": "https://github.com/GooDAnDReaDY/dsh-russian-lang/issues"
  },
  "bin": {
    "dsh-i18n": "./bin/dsh-i18n.mjs"
  }
}
