[Unit]
Description=dsh-russian-lang: upstream dictionary drift check
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__REPO__
Environment="PATH=__HOME__/.ssh/bin:/usr/local/bin:/usr/bin:/bin"
Environment="GIT_BIN=__HOME__/.ssh/bin/git-codex"
ExecStart=/usr/bin/python3 tools/upstream_check.py
TimeoutStartSec=1800
